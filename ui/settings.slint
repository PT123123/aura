import { Button, CheckBox, ComboBox, GroupBox, HorizontalBox, LineEdit, ScrollView, Spinner, SpinBox, VerticalBox } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    title: "Aura 设置";
    width: 620px;
    height: 760px;
    background: #1e1e1e;

    // ---- editable properties, synced from Rust ----
    in-out property <int> renderer-index: 0;
    in-out property <int> image-timer-secs: 300;
    in-out property <int> remote-update-secs: 3600;
    in-out property <int> format-index: 0;
    in-out property <int> jpeg-quality: 90;
    in-out property <string> sources-summary: "";
    in-out property <bool> wallhaven-enabled: false;
    in-out property <string> wallhaven-query: "";
    in-out property <bool> wallhaven-cat-general: true;
    in-out property <bool> wallhaven-cat-people: true;
    in-out property <bool> wallhaven-cat-anime: true;
    in-out property <bool> wallhaven-purity-sfw: true;
    in-out property <bool> wallhaven-purity-sketchy: false;
    in-out property <bool> wallhaven-purity-nsfw: false;
    in-out property <int> wallhaven-sorting-index: 0;
    in-out property <int> wallhaven-top-range-index: 3;
    in-out property <int> wallhaven-atleast-index: 0;
    in-out property <int> wallhaven-max-items: 24;
    in-out property <string> wallhaven-api-key: "";
    in-out property <bool> updater-enabled: true;
    in-out property <int> updater-interval-secs: 21600;
    in-out property <string> feed-url: "";
    in-out property <string> shader-name: "";
    in-out property <int> shader-fps: 60;
    in-out property <int> shader-resolution: 100;
    in-out property <bool> shader-mouse-enabled: false;
    in-out property <int> shader-scope-index: 0;
    in-out property <int> shader-color-space-index: 0;
    in-out property <int> log-level-index: 2;
    in-out property <string> cache-dir: "";
    in-out property <string> state-file: "";
    in-out property <string> status-text: "";

    callback save();
    callback reload-settings();
    callback open-config-file();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        ScrollView {
            VerticalBox {
                spacing: 12px;

                GroupBox {
                    title: "渲染 Renderer";
                    VerticalBox {
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "模式"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["图片 Image", "着色器 Shader"];
                                current-index: root.renderer-index;
                                selected => { root.renderer-index = self.current-index; }
                            }
                        }
                    }
                }

                GroupBox {
                    title: "图片 Image";
                    VerticalBox {
                        spacing: 8px;
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "轮换间隔 (秒)"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 5; maximum: 86400; value: root.image-timer-secs; edited => { root.image-timer-secs = round(self.value); } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "远程更新间隔 (秒)"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 60; maximum: 86400; value: root.remote-update-secs; edited => { root.remote-update-secs = round(self.value); } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "输出格式"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["png", "jpg"];
                                current-index: root.format-index;
                                selected => { root.format-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "JPEG 质量"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 1; maximum: 100; value: root.jpeg-quality; edited => { root.jpeg-quality = round(self.value); } }
                        }
                        GroupBox {
                            title: "图片来源 Sources";
                            Text {
                                text: root.sources-summary;
                                color: #c8c8c8;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                GroupBox {
                    title: "着色器 Shader";
                    VerticalBox {
                        spacing: 8px;
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "名称"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.shader-name; edited => { root.shader-name = self.text; } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "目标帧率"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 1; maximum: 240; value: root.shader-fps; edited => { root.shader-fps = round(self.value); } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "分辨率 (%)"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 10; maximum: 100; value: root.shader-resolution; edited => { root.shader-resolution = round(self.value); } }
                        }
                        CheckBox {
                            text: "启用鼠标交互";
                            checked: root.shader-mouse-enabled;
                            toggled => { root.shader-mouse-enabled = self.checked; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "桌面范围"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["virtual", "primary"];
                                current-index: root.shader-scope-index;
                                selected => { root.shader-scope-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "色彩空间"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["unorm", "srgb"];
                                current-index: root.shader-color-space-index;
                                selected => { root.shader-color-space-index = self.current-index; }
                            }
                        }
                    }
                }

                GroupBox {
                    title: "更新 Updater";
                    VerticalBox {
                        spacing: 8px;
                        CheckBox {
                            text: "启用自动更新";
                            checked: root.updater-enabled;
                            toggled => { root.updater-enabled = self.checked; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "检查间隔 (秒)"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 60; maximum: 604800; value: root.updater-interval-secs; edited => { root.updater-interval-secs = round(self.value); } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "更新源 URL"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.feed-url; edited => { root.feed-url = self.text; } }
                        }
                    }
                }

                GroupBox {
                    title: "Wallhaven 壁纸源";
                    VerticalBox {
                        spacing: 8px;
                        CheckBox {
                            text: "启用 Wallhaven 源";
                            checked: root.wallhaven-enabled;
                            toggled => { root.wallhaven-enabled = self.checked; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "查询关键词"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.wallhaven-query; edited => { root.wallhaven-query = self.text; } }
                        }
                        GroupBox {
                            title: "分类 Categories";
                            VerticalBox {
                                spacing: 4px;
                                CheckBox { text: "general 通用"; checked: root.wallhaven-cat-general; toggled => { root.wallhaven-cat-general = self.checked; } }
                                CheckBox { text: "people 人物"; checked: root.wallhaven-cat-people; toggled => { root.wallhaven-cat-people = self.checked; } }
                                CheckBox { text: "anime 动漫"; checked: root.wallhaven-cat-anime; toggled => { root.wallhaven-cat-anime = self.checked; } }
                            }
                        }
                        GroupBox {
                            title: "纯度 Purity";
                            VerticalBox {
                                spacing: 4px;
                                CheckBox { text: "SFW 安全"; checked: root.wallhaven-purity-sfw; toggled => { root.wallhaven-purity-sfw = self.checked; } }
                                CheckBox { text: "Sketchy 草稿"; checked: root.wallhaven-purity-sketchy; toggled => { root.wallhaven-purity-sketchy = self.checked; } }
                                CheckBox { text: "NSFW 成人"; checked: root.wallhaven-purity-nsfw; toggled => { root.wallhaven-purity-nsfw = self.checked; } }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "排序"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["date_added 最新", "relevance 相关", "random 随机", "views 浏览量", "favorites 收藏", "toplist 榜单"];
                                current-index: root.wallhaven-sorting-index;
                                selected => { root.wallhaven-sorting-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "时间范围"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["1d 一天", "3d 三天", "1w 一周", "1M 一月", "3M 三月", "6M 半年", "1y 一年"];
                                current-index: root.wallhaven-top-range-index;
                                selected => { root.wallhaven-top-range-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "最小分辨率"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["不限制", "1920x1080", "2560x1440", "3840x2160"];
                                current-index: root.wallhaven-atleast-index;
                                selected => { root.wallhaven-atleast-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "拉取数量"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 1; maximum: 1000; value: root.wallhaven-max-items; edited => { root.wallhaven-max-items = self.value; } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "API Key（可选）"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.wallhaven-api-key; edited => { root.wallhaven-api-key = self.text; } }
                        }
                    }
                }
                GroupBox {
                    title: "通用 General";
                    VerticalBox {
                        spacing: 8px;
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "日志级别"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["error", "warn", "info", "debug", "trace"];
                                current-index: root.log-level-index;
                                selected => { root.log-level-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "缓存目录"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.cache-dir; enabled: false; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "状态文件"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.state-file; enabled: false; }
                        }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button { text: "保存并重载"; primary: true; clicked => { root.save(); } }
            Button { text: "重新载入"; clicked => { root.reload-settings(); } }
            Button { text: "打开配置文件"; clicked => { root.open-config-file(); } }
        }

        Text { text: root.status-text; color: #9a9a9a; wrap: word-wrap; }
    }
}

struct WallpaperCell {
    path: string,
    thumb: image,
    name: string,
    favorited: bool,
}

export component WallpaperPickerWindow inherits Window {
    title: "选择壁纸";
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 640px;
    min-height: 480px;
    background: #1e1e1e;

    in property <[WallpaperCell]> cells: [];
    in property <[string]> monitor-names: [];
    in property <bool> loading: true;
    in property <int> total-count: 0;
    in property <int> shown-count: 0;
    in-out property <string> search-text: "";
    in-out property <bool> favorites-only: false;
    in-out property <string> selected-path: "";
    callback apply-all(string);
    callback apply-to-monitor(string, int);
    callback add-favorite(string);
    callback filter-changed(string, bool);
    callback close-window();

    // ~210px per column with room for padding/spacing, clamped to 2–6 columns.
    property <int> grid-cols: max(2, min(6, round((root.width - 58px) / 210px)));
    out property <string> status-text: root.loading
        ? "正在加载缩略图…"
        : root.shown-count == 0
            ? (root.total-count == 0 ? "暂无可用壁纸" : "没有匹配的壁纸，换个关键词试试")
            : "显示 " + root.shown-count + " / " + root.total-count + " 张 · 单击选择，右键可应用到指定屏幕或收藏";

    VerticalBox {
        padding: 12px;
        spacing: 10px;

        HorizontalBox {
            spacing: 8px;
            Text {
                text: "选择壁纸";
                color: #e0e0e0;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "搜索壁纸名称或路径…";
                input-type: search;
                text: root.search-text;
                edited(text) => {
                    root.search-text = text;
                    root.filter-changed(text, root.favorites-only);
                }
            }
            CheckBox {
                text: "仅收藏";
                checked: root.favorites-only;
                toggled => {
                    root.favorites-only = self.checked;
                    root.filter-changed(root.search-text, self.checked);
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #1e1e1e;

            ScrollView {
                visible: !root.loading && root.cells.length > 0;
                GridLayout {
                    padding: 4px;
                    spacing: 10px;
                    for cell[idx] in root.cells:
                        ContextMenuArea {
                            row: idx / root.grid-cols;
                            col: Math.mod(idx, root.grid-cols);

                            Menu {
                                for name[monitor-idx] in root.monitor-names: MenuItem {
                                    title: "应用到 " + name;
                                    activated => { root.apply-to-monitor(cell.path, monitor-idx); }
                                }
                                MenuItem {
                                    title: "应用到所有屏幕";
                                    activated => { root.apply-all(cell.path); }
                                }
                                MenuSeparator {}
                                MenuItem {
                                    title: cell.favorited ? "取消收藏" : "加入收藏";
                                    activated => { root.add-favorite(cell.path); }
                                }
                            }

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: root.selected-path == cell.path
                                    ? #31353d
                                    : (select-touch.has-hover ? #2b2b2b : #262626);
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.selected-path == cell.path
                                    ? #4a90d9
                                    : (cell.favorited ? #d4a017 : (select-touch.has-hover ? #4a4a4a : #3a3a3a));
                                clip: true;

                                select-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.selected-path = cell.path; }
                                }

                                VerticalBox {
                                    width: 100%;
                                    height: 100%;
                                    spacing: 0px;
                                    padding: 0px;

                                    Rectangle {
                                        vertical-stretch: 1;
                                        min-height: 100px;

                                        Image {
                                            source: cell.thumb;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: cover;
                                        }

                                        Rectangle {
                                            visible: cell.favorited;
                                            x: parent.width - self.width - 6px;
                                            y: 6px;
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 12px;
                                            background: #000000aa;
                                            Text {
                                                text: "★";
                                                color: #d4a017;
                                                font-size: 12px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            y: parent.height - self.height;
                                            width: 100%;
                                            height: select-touch.has-hover || root.selected-path == cell.path ? 30px : 0px;
                                            background: #000000c4;
                                            TouchArea {
                                                width: 100%;
                                                height: 30px;
                                                visible: select-touch.has-hover || root.selected-path == cell.path;
                                                mouse-cursor: pointer;
                                                clicked => { root.apply-all(cell.path); }
                                                Text {
                                                    text: "应用到全部屏幕";
                                                    color: #f0f0f0;
                                                    font-size: 12px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalBox {
                                        padding: 6px;
                                        spacing: 4px;
                                        Text {
                                            text: cell.name;
                                            color: #c8c8c8;
                                            font-size: 11px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: cell.favorited ? "★" : "";
                                            color: #d4a017;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                }
            }

            if (root.loading || root.cells.length == 0): Rectangle {
                width: 100%;
                height: 100%;
                VerticalBox {
                    alignment: center;
                    spacing: 8px;
                    if (root.loading): Spinner {}
                    Text {
                        text: root.status-text;
                        color: #9a9a9a;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Text {
                text: root.status-text;
                color: #9a9a9a;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "应用所选";
                primary: root.selected-path != "";
                enabled: root.selected-path != "" && !root.loading;
                clicked => { root.apply-all(root.selected-path); }
            }
            Button {
                text: "关闭";
                clicked => { root.close-window(); }
            }
        }
    }
}
