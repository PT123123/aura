import { Button, CheckBox, ComboBox, GroupBox, HorizontalBox, LineEdit, ScrollView, Spinner, SpinBox, VerticalBox } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    title: "Aura 设置";
    width: 620px;
    height: 760px;
    background: #1e1e1e;

    // ---- editable properties, synced from Rust ----
    in-out property <int> renderer-index: 0;
    in-out property <int> image-timer-secs: 300;
    in-out property <int> remote-update-secs: 3600;
    in-out property <int> format-index: 0;
    in-out property <int> jpeg-quality: 90;
    in-out property <string> sources-summary: "";
    in-out property <bool> wallhaven-enabled: false;
    in-out property <string> wallhaven-query: "";
    in-out property <bool> wallhaven-cat-general: true;
    in-out property <bool> wallhaven-cat-people: true;
    in-out property <bool> wallhaven-cat-anime: true;
    in-out property <bool> wallhaven-purity-sfw: true;
    in-out property <bool> wallhaven-purity-sketchy: false;
    in-out property <bool> wallhaven-purity-nsfw: false;
    in-out property <int> wallhaven-sorting-index: 0;
    in-out property <int> wallhaven-top-range-index: 3;
    in-out property <int> wallhaven-atleast-index: 0;
    in-out property <int> wallhaven-max-items: 24;
    in-out property <string> wallhaven-api-key: "";
    in-out property <bool> updater-enabled: true;
    in-out property <int> updater-interval-secs: 21600;
    in-out property <string> feed-url: "";
    in-out property <string> shader-name: "";
    in-out property <int> shader-fps: 60;
    in-out property <int> shader-resolution: 100;
    in-out property <bool> shader-mouse-enabled: false;
    in-out property <int> shader-scope-index: 0;
    in-out property <int> shader-color-space-index: 0;
    in-out property <int> log-level-index: 2;
    in-out property <string> cache-dir: "";
    in-out property <string> state-file: "";
    in-out property <string> proxy-url: "";
    in-out property <int> tray-double-click-index: 0;
    in-out property <string> status-text: "";

    callback save();
    callback reload-settings();
    callback open-config-file();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        ScrollView {
            VerticalBox {
                spacing: 12px;

                GroupBox {
                    title: "渲染 Renderer";
                    VerticalBox {
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "模式"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["图片 Image", "着色器 Shader"];
                                current-index: root.renderer-index;
                                selected => { root.renderer-index = self.current-index; }
                            }
                        }
                    }
                }

                GroupBox {
                    title: "图片 Image";
                    VerticalBox {
                        spacing: 8px;
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "轮换间隔 (秒)"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 5; maximum: 86400; value: root.image-timer-secs; edited => { root.image-timer-secs = round(self.value); } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "远程更新间隔 (秒)"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 60; maximum: 86400; value: root.remote-update-secs; edited => { root.remote-update-secs = round(self.value); } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "输出格式"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["png", "jpg"];
                                current-index: root.format-index;
                                selected => { root.format-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "JPEG 质量"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 1; maximum: 100; value: root.jpeg-quality; edited => { root.jpeg-quality = round(self.value); } }
                        }
                        GroupBox {
                            title: "图片来源 Sources";
                            Text {
                                text: root.sources-summary;
                                color: #c8c8c8;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                GroupBox {
                    title: "着色器 Shader";
                    VerticalBox {
                        spacing: 8px;
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "名称"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.shader-name; edited => { root.shader-name = self.text; } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "目标帧率"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 1; maximum: 240; value: root.shader-fps; edited => { root.shader-fps = round(self.value); } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "分辨率 (%)"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 10; maximum: 100; value: root.shader-resolution; edited => { root.shader-resolution = round(self.value); } }
                        }
                        CheckBox {
                            text: "启用鼠标交互";
                            checked: root.shader-mouse-enabled;
                            toggled => { root.shader-mouse-enabled = self.checked; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "桌面范围"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["virtual", "primary"];
                                current-index: root.shader-scope-index;
                                selected => { root.shader-scope-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "色彩空间"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["unorm", "srgb"];
                                current-index: root.shader-color-space-index;
                                selected => { root.shader-color-space-index = self.current-index; }
                            }
                        }
                    }
                }

                GroupBox {
                    title: "更新 Updater";
                    VerticalBox {
                        spacing: 8px;
                        CheckBox {
                            text: "启用自动更新";
                            checked: root.updater-enabled;
                            toggled => { root.updater-enabled = self.checked; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "检查间隔 (秒)"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 60; maximum: 604800; value: root.updater-interval-secs; edited => { root.updater-interval-secs = round(self.value); } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "更新源 URL"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.feed-url; edited => { root.feed-url = self.text; } }
                        }
                    }
                }

                GroupBox {
                    title: "Wallhaven 壁纸源";
                    VerticalBox {
                        spacing: 8px;
                        CheckBox {
                            text: "启用 Wallhaven 源";
                            checked: root.wallhaven-enabled;
                            toggled => { root.wallhaven-enabled = self.checked; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "查询关键词"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.wallhaven-query; edited => { root.wallhaven-query = self.text; } }
                        }
                        GroupBox {
                            title: "分类 Categories";
                            VerticalBox {
                                spacing: 4px;
                                CheckBox { text: "general 通用"; checked: root.wallhaven-cat-general; toggled => { root.wallhaven-cat-general = self.checked; } }
                                CheckBox { text: "people 人物"; checked: root.wallhaven-cat-people; toggled => { root.wallhaven-cat-people = self.checked; } }
                                CheckBox { text: "anime 动漫"; checked: root.wallhaven-cat-anime; toggled => { root.wallhaven-cat-anime = self.checked; } }
                            }
                        }
                        GroupBox {
                            title: "纯度 Purity";
                            VerticalBox {
                                spacing: 4px;
                                CheckBox { text: "SFW 安全"; checked: root.wallhaven-purity-sfw; toggled => { root.wallhaven-purity-sfw = self.checked; } }
                                CheckBox { text: "Sketchy 草稿"; checked: root.wallhaven-purity-sketchy; toggled => { root.wallhaven-purity-sketchy = self.checked; } }
                                CheckBox { text: "NSFW 成人"; checked: root.wallhaven-purity-nsfw; toggled => { root.wallhaven-purity-nsfw = self.checked; } }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "排序"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["date_added 最新", "relevance 相关", "random 随机", "views 浏览量", "favorites 收藏", "toplist 榜单"];
                                current-index: root.wallhaven-sorting-index;
                                selected => { root.wallhaven-sorting-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "时间范围"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["1d 一天", "3d 三天", "1w 一周", "1M 一月", "3M 三月", "6M 半年", "1y 一年"];
                                current-index: root.wallhaven-top-range-index;
                                selected => { root.wallhaven-top-range-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "最小分辨率"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["不限制", "1920x1080", "2560x1440", "3840x2160"];
                                current-index: root.wallhaven-atleast-index;
                                selected => { root.wallhaven-atleast-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "拉取数量"; color: #e0e0e0; vertical-alignment: center; }
                            SpinBox { minimum: 1; maximum: 1000; value: root.wallhaven-max-items; edited => { root.wallhaven-max-items = self.value; } }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "API Key（可选）"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.wallhaven-api-key; edited => { root.wallhaven-api-key = self.text; } }
                        }
                    }
                }
                GroupBox {
                    title: "通用 General";
                    VerticalBox {
                        spacing: 8px;
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "日志级别"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["error", "warn", "info", "debug", "trace"];
                                current-index: root.log-level-index;
                                selected => { root.log-level-index = self.current-index; }
                            }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "缓存目录"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.cache-dir; enabled: false; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "状态文件"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit { text: root.state-file; enabled: false; }
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "HTTP 代理"; color: #e0e0e0; vertical-alignment: center; }
                            LineEdit {
                                text: root.proxy-url;
                                placeholder-text: "如 http://127.0.0.1:10809（留空则用环境变量）";
                                edited => { root.proxy-url = self.text; }
                            }
                        }
                        Text {
                            text: "远程图源（RSS / Wallhaven）走这个代理；保存并重载后生效。";
                            color: #8a8a8a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "双击托盘图标"; color: #e0e0e0; vertical-alignment: center; }
                            ComboBox {
                                model: ["切换下一张 (默认)", "打开选择壁纸界面"];
                                current-index: root.tray-double-click-index;
                                selected => { root.tray-double-click-index = self.current-index; }
                            }
                        }
                        Text {
                            text: "默认双击切换下一张；改完后保存并重载生效。";
                            color: #8a8a8a;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button { text: "保存并重载"; primary: true; clicked => { root.save(); } }
            Button { text: "重新载入"; clicked => { root.reload-settings(); } }
            Button { text: "打开配置文件"; clicked => { root.open-config-file(); } }
        }

        Text { text: root.status-text; color: #9a9a9a; wrap: word-wrap; }
    }
}

struct WallpaperCell {
    path: string,
    thumb: image,
    name: string,
    favorited: bool,
    meta: string,
    local: bool,
}

struct MonitorChip {
    name: string,
    selected: bool,
}

// Small pill-shaped toggle used by the display chooser and the per-card
// hover actions.
component PickerChip inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <length> chip-width: 96px;
    callback clicked();

    width: chip-width;
    height: 26px;
    border-radius: 13px;
    background: active ? #2f5d8f : #2b2f36;
    border-width: 1px;
    border-color: active ? #4a90d9 : #3a4048;

    Text {
        text: root.label;
        color: root.active ? #ffffff : #c8c8c8;
        font-size: 12px;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    chip-touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component WallpaperPickerWindow inherits Window {
    title: "选择壁纸";
    preferred-width: 1100px;
    preferred-height: 740px;
    min-width: 780px;
    min-height: 560px;
    background: #1e1e1e;

    in property <[WallpaperCell]> cells: [];
    in property <[MonitorChip]> monitors: [];
    /// Shared chip width for the display row, sized by the widest display name.
    in property <length> monitor-chip-width: 96px;
    in property <bool> loading: true;
    in property <bool> fetching: false;
    in property <string> fetch-status: "";
    in property <int> total-count: 0;
    in property <int> shown-count: 0;
    in property <int> selected-monitor-count: 0;
    in-out property <string> search-text: "";
    in-out property <bool> favorites-only: false;
    in-out property <int> source-index: 0;
    in-out property <int> min-resolution-index: 0;
    in-out property <int> sort-index: 0;
    in-out property <string> selected-path: "";
    in-out property <string> fetch-query: "";
    in-out property <int> fetch-count: 24;
    in-out property <int> fetch-category-index: 0;
    in-out property <int> fetch-purity-index: 0;
    in-out property <int> fetch-sorting-index: 0;
    in-out property <int> fetch-atleast-index: 0;
    in-out property <bool> fetch-panel-open: false;

    callback apply-all(string);
    callback apply-to-monitor(string, int);
    callback apply-to-selection(string);
    callback add-favorite(string);
    callback search-changed(string);
    callback favorites-toggled(bool);
    callback source-changed(int);
    callback min-resolution-changed(int);
    callback sort-changed(int);
    callback toggle-monitor(int);
    callback select-all-monitors(bool);
    callback refresh-requested();
    callback fetch-requested(string, int, int, int, int, int);
    callback open-in-folder(string);
    callback close-window();
    callback confirm-delete(string);

    in-out property <bool> confirm-visible: false;
    in-out property <string> delete-pending-path: "";
    in-out property <bool> delete-pending-local: false;
    in-out property <bool> selected-local: false;

    // ~200px per column with room for padding/spacing, clamped to 2–8 columns.
    property <int> grid-cols: max(2, min(8, round((root.width - 58px) / 200px)));

    out property <string> status-text: root.loading
        ? "正在加载缩略图…"
        : root.shown-count == 0
            ? (root.total-count == 0
                ? "本地暂无可用壁纸，点右上角「获取更多」在线拉取"
                : "没有匹配的壁纸，放宽筛选条件试试")
            : "显示 " + root.shown-count + " / " + root.total-count + " 张";

    out property <string> screen-summary: root.monitors.length == 0
        ? "未检测到显示器枚举，将应用到全部屏幕"
        : root.selected-monitor-count == 0
            ? "未勾选屏幕 → 应用时作用于全部屏幕"
            : "已勾选 " + root.selected-monitor-count + " 个屏幕";

    VerticalBox {
        padding: 12px;
        spacing: 10px;

        // ---- title / search / toolbar ----
        HorizontalBox {
            spacing: 8px;
            Text {
                text: "选择壁纸";
                color: #e0e0e0;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "搜索壁纸名称或路径…";
                input-type: search;
                text: root.search-text;
                edited(text) => {
                    root.search-text = text;
                    root.search-changed(text);
                }
            }
            Button {
                text: root.fetch-panel-open ? "收起拉取" : "获取更多…";
                clicked => { root.fetch-panel-open = !root.fetch-panel-open; }
            }
            Button {
                text: "重新扫描";
                clicked => { root.refresh-requested(); }
            }
        }

        // ---- online fetch panel ----
        Rectangle {
            visible: root.fetch-panel-open;
            background: #23272e;
            border-radius: 6px;
            border-width: 1px;
            border-color: #2f353d;

            VerticalBox {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "从 Wallhaven 在线获取更多壁纸";
                    color: #e0e0e0;
                    font-size: 13px;
                    font-weight: 600;
                }

                HorizontalBox {
                    spacing: 6px;
                    Text { text: "关键词"; color: #9a9a9a; font-size: 12px; vertical-alignment: center; }
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "留空 = 不限主题；中文标签如「风景」请用英文关键词";
                        text: root.fetch-query;
                        edited(text) => { root.fetch-query = text; }
                    }
                    Text { text: "数量"; color: #9a9a9a; font-size: 12px; vertical-alignment: center; }
                    SpinBox {
                        minimum: 4;
                        maximum: 96;
                        value: root.fetch-count;
                        edited => { root.fetch-count = round(self.value); }
                    }
                }

                HorizontalBox {
                    spacing: 6px;
                    Text { text: "分类"; color: #9a9a9a; font-size: 12px; vertical-alignment: center; }
                    ComboBox {
                        min-width: 150px;
                        model: ["通用+人物+动漫", "general 通用", "people 人物", "anime 动漫"];
                        current-index: root.fetch-category-index;
                        selected => { root.fetch-category-index = self.current-index; }
                    }
                    Text { text: "纯度"; color: #9a9a9a; font-size: 12px; vertical-alignment: center; }
                    ComboBox {
                        min-width: 116px;
                        model: ["仅 SFW", "含 Sketchy", "含 NSFW"];
                        current-index: root.fetch-purity-index;
                        selected => { root.fetch-purity-index = self.current-index; }
                    }
                    Text { text: "排序"; color: #9a9a9a; font-size: 12px; vertical-alignment: center; }
                    ComboBox {
                        min-width: 130px;
                        model: ["随机", "最新", "榜单", "浏览量", "收藏数"];
                        current-index: root.fetch-sorting-index;
                        selected => { root.fetch-sorting-index = self.current-index; }
                    }
                    Text { text: "最低分辨率"; color: #9a9a9a; font-size: 12px; vertical-alignment: center; }
                    ComboBox {
                        min-width: 116px;
                        model: ["不限", "1920x1080", "2560x1440", "3840x2160"];
                        current-index: root.fetch-atleast-index;
                        selected => { root.fetch-atleast-index = self.current-index; }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    Button {
                        text: root.fetching ? "拉取中…" : "开始拉取";
                        primary: true;
                        enabled: !root.fetching;
                        clicked => {
                            root.fetch-requested(
                                root.fetch-query,
                                root.fetch-count,
                                root.fetch-category-index,
                                root.fetch-purity-index,
                                root.fetch-sorting-index,
                                root.fetch-atleast-index,
                            );
                        }
                    }
                    Text {
                        text: root.fetch-status;
                        color: #9a9a9a;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }

                Text {
                    text: "拉取会下载进本地缓存并立即出现在网格里，同时进入自动轮换队列。若远程站点无法直连，请在设置里填写 proxy。";
                    color: #757575;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        // ---- filters ----
        HorizontalBox {
            spacing: 6px;
            Text { text: "来源"; color: #9a9a9a; font-size: 12px; vertical-alignment: center; }
            ComboBox {
                min-width: 112px;
                model: ["全部来源", "远程缓存", "本地文件"];
                current-index: root.source-index;
                selected => {
                    root.source-index = self.current-index;
                    root.source-changed(self.current-index);
                }
            }
            Text { text: "分辨率"; color: #9a9a9a; font-size: 12px; vertical-alignment: center; }
            ComboBox {
                min-width: 110px;
                model: ["不限", "≥1080p", "≥1440p", "≥4K"];
                current-index: root.min-resolution-index;
                selected => {
                    root.min-resolution-index = self.current-index;
                    root.min-resolution-changed(self.current-index);
                }
            }
            Text { text: "排序"; color: #9a9a9a; font-size: 12px; vertical-alignment: center; }
            ComboBox {
                min-width: 128px;
                model: ["名称 A→Z", "名称 Z→A", "最新在前", "最旧在前", "分辨率高→低", "文件大→小"];
                current-index: root.sort-index;
                selected => {
                    root.sort-index = self.current-index;
                    root.sort-changed(self.current-index);
                }
            }
            CheckBox {
                text: "仅收藏";
                checked: root.favorites-only;
                toggled => {
                    root.favorites-only = self.checked;
                    root.favorites-toggled(self.checked);
                }
            }
            Text {
                text: root.status-text;
                color: #9a9a9a;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                overflow: elide;
            }
        }

        // ---- thumbnail grid ----
        Rectangle {
            vertical-stretch: 1;
            background: #1e1e1e;

            ScrollView {
                visible: !root.loading && root.cells.length > 0;
                GridLayout {
                    padding: 4px;
                    spacing: 10px;
                    for cell[idx] in root.cells:
                        ContextMenuArea {
                            row: idx / root.grid-cols;
                            col: Math.mod(idx, root.grid-cols);

                            Menu {
                                for monitor[monitor-idx] in root.monitors: MenuItem {
                                    title: "应用到 " + monitor.name;
                                    activated => { root.apply-to-monitor(cell.path, monitor-idx); }
                                }
                                MenuItem {
                                    title: "应用到所有屏幕";
                                    activated => { root.apply-all(cell.path); }
                                }
                                MenuSeparator {}
                                MenuItem {
                                    title: cell.favorited ? "取消收藏" : "加入收藏";
                                    activated => { root.add-favorite(cell.path); }
                                }
                                MenuItem {
                                    title: "在文件夹中显示";
                                    activated => { root.open-in-folder(cell.path); }
                                }
                                MenuSeparator {}
                                MenuItem {
                                    title: "删除";
                                    activated => {
                                        root.delete-pending-path = cell.path;
                                        root.delete-pending-local = cell.local;
                                        root.confirm-visible = true;
                                    }
                                }
                            }

                            Rectangle {
                                min-width: 170px;
                                min-height: 136px;
                                background: root.selected-path == cell.path
                                    ? #31353d
                                    : (card-touch.has-hover ? #2b2b2b : #262626);
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.selected-path == cell.path
                                    ? #4a90d9
                                    : (cell.favorited ? #d4a017 : (card-touch.has-hover ? #4a4a4a : #3a3a3a));
                                clip: true;

                                card-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected-path = cell.path;
                                        root.selected-local = cell.local;
                                    }
                                }

                                VerticalBox {
                                    width: 100%;
                                    height: 100%;
                                    spacing: 0px;
                                    padding: 0px;

                                    Rectangle {
                                        vertical-stretch: 1;
                                        min-height: 96px;

                                        Image {
                                            source: cell.thumb;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: cover;
                                        }

                                        Rectangle {
                                            visible: cell.local;
                                            x: 6px;
                                            y: 6px;
                                            width: 36px;
                                            height: 18px;
                                            border-radius: 9px;
                                            background: #000000aa;
                                            Text {
                                                text: "本地";
                                                color: #cfe3ff;
                                                font-size: 10px;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            visible: cell.favorited;
                                            x: parent.width - self.width - 6px;
                                            y: 6px;
                                            width: 22px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: #000000aa;
                                            Text {
                                                text: "★";
                                                color: #d4a017;
                                                font-size: 11px;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            y: parent.height - self.height;
                                            width: 100%;
                                            height: (card-touch.has-hover || root.selected-path == cell.path) ? 30px : 0px;
                                            background: #000000cc;
                                            clip: true;

                                            HorizontalBox {
                                                alignment: center;
                                                spacing: 6px;
                                                PickerChip {
                                                    label: "应用";
                                                    chip-width: 60px;
                                                    active: true;
                                                    clicked => { root.apply-to-selection(cell.path); }
                                                }
                                                PickerChip {
                                                    label: cell.favorited ? "取消收藏" : "收藏";
                                                    chip-width: 76px;
                                                    clicked => { root.add-favorite(cell.path); }
                                                }
                                            }
                                        }
                                    }

                                    HorizontalBox {
                                        padding: 6px;
                                        spacing: 4px;
                                        Text {
                                            text: cell.name;
                                            color: #c8c8c8;
                                            font-size: 11px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: cell.meta;
                                            color: #858585;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                }
            }

            if (root.loading || root.cells.length == 0): Rectangle {
                width: 100%;
                height: 100%;
                VerticalBox {
                    alignment: center;
                    spacing: 8px;
                    if (root.loading): Spinner {}
                    Text {
                        text: root.status-text;
                        color: #9a9a9a;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // ---- display chooser ----
        Rectangle {
            background: #23272e;
            border-radius: 6px;
            border-width: 1px;
            border-color: #2f353d;

            HorizontalBox {
                padding: 8px;
                spacing: 6px;

                Text {
                    text: "应用到";
                    color: #c8c8c8;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                if (root.monitors.length == 0): Text {
                    text: "全部屏幕";
                    color: #858585;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                for monitor[idx] in root.monitors: PickerChip {
                    label: monitor.name;
                    active: monitor.selected;
                    chip-width: root.monitor-chip-width;
                    clicked => { root.toggle-monitor(idx); }
                }

                if (root.monitors.length > 0): PickerChip {
                    label: "全选";
                    chip-width: 56px;
                    clicked => { root.select-all-monitors(true); }
                }

                if (root.monitors.length > 0): PickerChip {
                    label: "清空";
                    chip-width: 56px;
                    clicked => { root.select-all-monitors(false); }
                }

                Text {
                    text: root.screen-summary;
                    color: #858585;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }

        // ---- footer ----
        HorizontalBox {
            spacing: 8px;
            Text {
                text: root.selected-path == "" ? root.status-text : "已选择 · " + root.selected-path;
                color: #9a9a9a;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "应用所选";
                primary: root.selected-path != "";
                enabled: root.selected-path != "" && !root.loading;
                clicked => { root.apply-to-selection(root.selected-path); }
            }
            Button {
                text: "关闭";
                clicked => { root.close-window(); }
            }
        }
    }

    // ---- delete confirmation overlay (Window-level, absolute) ----
    if (root.confirm-visible): Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #000000a8;

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 380px;
            height: 188px;
            background: #2b2f36;
            border-radius: 10px;
            border-width: 1px;
            border-color: #3a3f47;

            VerticalBox {
                padding: 18px;
                spacing: 14px;

                Text {
                    text: root.delete-pending-local ? "永久删除这张本地图片？" : "从缓存中删除这张壁纸？";
                    color: #f0f0f0;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: root.delete-pending-local
                        ? "将删除磁盘上的原始文件，操作不可恢复。"
                        : "将删除缓存文件并停止轮换，操作不可恢复。";
                    color: #b8b8b8;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalBox {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: "取消";
                        clicked => { root.confirm-visible = false; }
                    }
                    Button {
                        text: "删除";
                        primary: true;
                        clicked => { root.confirm-delete(root.delete-pending-path); }
                    }
                }
            }
        }
    }
}
